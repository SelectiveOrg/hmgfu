  {"id": "predicate_is_not_the_name", "family": "precision", "messages": ["My dog is Rex.", "My dog Rex is 4 years old."], "expect": {"active": {"pet.dog.name": "Rex"}, "render_absent": ["4 years old"]}},
  {"id": "breed_sentence_writes_nothing_wrong", "family": "precision", "messages": ["My dog is Rex.", "Rex is a beagle."], "expect": {"active_subset": {"pet.dog.name": "Rex"}, "render_absent": ["beagle"]}},
  {"id": "restatement_no_duplicate", "family": "restatement", "messages": ["My name is Nadia Costa.", "My name is Nadia Costa."], "expect": {"active": {"identity.name": "Nadia Costa"}}},
